# Copia este archivo como .env y cambia los valores. El .env nunca se sube al repositorio.

# Base de datos. Sin Docker ni PostgreSQL también funciona con SQLite:
# DATABASE_URL=sqlite:///./ferremarket.db
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379/0

# Al menos 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacía: cada arranque genera una llave nueva y las sesiones abiertas se cierran.
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7

# Dirección de la tienda (enlaces de los correos y CORS). Más orígenes, separados por coma, en CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
# En producción: COOKIE_SECURE=true (solo HTTPS), PASARELA_SANDBOX=false y SEED_SYNTHETIC_DATA=false.
COOKIE_SECURE=false
PASARELA_SANDBOX=true
SEED_SYNTHETIC_DATA=true

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=product-images

# Pasarela de pago. Vacía: pasarela simulada. Con sk_test_... (Stripe) o TEST-... (Mercado Pago): sandbox real.
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Respaldos 3-2-1 (POST /api/v1/admin/db-backup-321 o `python -m backend.shared.backups crear`).
# Sin BACKUP_ENCRYPTION_KEY no se generan respaldos. Guárdala fuera del servidor: sin ella no se pueden restaurar.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups/local
# Otro medio: disco externo, unidad de red o carpeta sincronizada con la nube.
BACKUP_OFFSITE_DIR=

# Roles de PostgreSQL con privilegio mínimo (12+ caracteres, mayúscula, minúscula, dígito y símbolo).
# Sin contraseña, el rol existe pero no puede iniciar sesión.
DB_ROLE_AUDITOR_PASSWORD=
DB_ROLE_APP_PASSWORD=
DB_ROLE_SUCURSAL_PASSWORD=
DB_ROLE_RESPALDO_PASSWORD=
# Ajusta postgresql.conf (log_statement=mod, conexiones). Requiere superusuario.
DB_AUDIT_SERVER_SETTINGS=false
